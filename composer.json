{
  "name": "plan2net/require-alt-text",
  "description": "Require alternative text for images in TYPO3 CMS",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "TYPO3",
    "extension",
    "accessibility",
    "a11y"
  ],
  "homepage": "https://www.plan2.net/",
  "authors": [
    {
      "name": "Stefan Hekele",
      "role": "Developer"
    },
    {
      "name": "Ioulia Kondratovitch",
      "role": "Developer"
    },
    {
      "name": "Wolfgang Klinger",
      "role": "Developer"
    }
  ],
  "require": {
    "typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
    "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
    "php": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/phpstan": "^2",
    "typo3/testing-framework": "^8.2 || ^9"
  },
  "autoload": {
    "psr-4": {
      "Plan2net\\RequireAltText\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plan2net\\RequireAltText\\Tests\\": "Tests"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "require_alt_text",
      "version": "1.1.0",
      "Package": {
        "providesPackages": {}
      }
    }
  },
  "scripts": {
    "php-cs-fixer": [
      "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer --config=./Build/php-cs-fixer.php fix --dry-run -v --diff"
    ],
    "php-cs-fixer:fix": [
      "PHP_CS_FIXER_IGNORE_ENV=1 ./vendor/bin/php-cs-fixer --config=./Build/php-cs-fixer.php fix -v"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --configuration=Build/phpstan.neon"
    ],
    "test": [
      "./vendor/bin/phpunit --testsuite unit"
    ],
    "test:functional": [
      "typo3DatabaseDriver=pdo_sqlite ./vendor/bin/phpunit --bootstrap vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php Tests/Functional"
    ],
    "lint": [
      "@phpstan",
      "@php-cs-fixer"
    ],
    "lint:fix": [
      "@phpstan",
      "@php-cs-fixer:fix"
    ]
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  }
}
